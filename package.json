{
  "name": "omn-e-invoice-automation",
  "version": "1.0.0",
  "description": "Test automation framework for OMN E-Invoice application using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:covoro": "playwright test tests/**/*CovoroTemplate*.spec.ts --project=chromium",
    "test:covoro:headed": "playwright test tests/**/*CovoroTemplate*.spec.ts --project=chromium --headed",
    "test:covoro:debug": "playwright test tests/**/*CovoroTemplate*.spec.ts --project=chromium --debug",
    "test:covoro:parallel": "playwright test tests/**/*CovoroTemplate*.spec.ts --project=chromium --workers=4",
    "test:all": "playwright test tests --project=chromium",
    "test:sanity": "playwright test tests/sanitysubmit/OMN_SubmitInvoice_Sanity_Test.spec.ts --project=chromium --workers=5",
    "report": "playwright show-report",
    "report:open": "npx playwright show-report playwright-report",
    "allure:generate": "npx allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "clean": "rimraf playwright-report test-results allure-results allure-report blob-report site-unavailable.json testData/generated && rimraf -g \"site-unavailable-w*.json\"",
    "install:browsers": "playwright install",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "testing",
    "omn-einvoice"
  ],
  "author": "QA Team",
  "license": "ISC",
  "engines": {
    "node": ">=22.14.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^20.19.33",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  }
}
